{
  "id": "pf2e-automato",
  "title": "PF2e AuTOMATO",
  "description": "<p><b>Тестовая версия.</b> Автоматизация PF2e для Foundry v14: зоны, испытания целей, состояния по степеням успеха, реакции и Мастерская для своих правил без JSON. Заменяет pf2e-automations и несовместим с ним.</p><p><b>Beta.</b> PF2e automation for Foundry v14: zones, target saves, conditions by degree of success, reactions, and a Workshop for authoring rules without JSON. Replaces pf2e-automations (incompatible).</p>",
  "version": "0.3.0",
  "authors": [{ "name": "StompingRhino", "url": "https://github.com/StompingRhino" }],
  "url": "https://github.com/StompingRhino/pf2e-automato",
  "manifest": "https://github.com/StompingRhino/pf2e-automato/releases/latest/download/module.json",
  "download": "https://github.com/StompingRhino/pf2e-automato/releases/download/v0.3.0/pf2e-automato.zip",
  "bugs": "https://github.com/StompingRhino/pf2e-automato/issues",
  "readme": "https://github.com/StompingRhino/pf2e-automato#readme",
  "license": "LICENSE",
  "compatibility": { "minimum": "14", "verified": "14.370" },
  "relationships": {
    "systems": [
      { "id": "pf2e", "type": "system", "compatibility": { "minimum": "8.6.1", "verified": "8.7.0" } }
    ],
    "requires": [
      { "id": "socketlib", "type": "module" }
    ],
    "recommends": [
      { "id": "lib-wrapper", "type": "module" },
      { "id": "pf2e-toolbelt", "type": "module" },
      { "id": "token-action-hud-pf2e", "type": "module" }
    ],
    "conflicts": [
      { "id": "pf2e-automations", "type": "module", "reason": "PF2e AuTOMATO already covers its automations; with both active, items are processed twice." }
    ]
  },
  "documentTypes": {
    "RegionBehavior": { "zone": {}, "height": {} }
  },
  "packs": [
    { "name": "effects", "label": "PF2e AuTOMATO: Effects", "type": "Item", "path": "packs/effects", "system": "pf2e", "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" } },
    { "name": "equipment", "label": "PF2e AuTOMATO: Equipment", "type": "Item", "path": "packs/equipment", "system": "pf2e", "ownership": { "PLAYER": "OBSERVER", "ASSISTANT": "OWNER" } }
  ],
  "socket": true,
  "esmodules": ["scripts/main.mjs"],
  "styles": ["styles/chat.css", "styles/dialog.css", "styles/sheet.css", "styles/workshop.css"],
