{
  "id": "pf2e-automato",
  "title": "PF2e AuTOMATO",
  "description": "Автоматизация PF2e для Foundry v14: зоны, испытания целей, состояния по степеням, реакции, макросы.",
  "version": "0.1.0",
  "compatibility": { "minimum": "14", "verified": "14.366" },
  "relationships": {
    "systems": [
      { "id": "pf2e", "type": "system", "compatibility": { "minimum": "8.6.1" } }
    ],
    "requires": [
      { "id": "socketlib", "type": "module" }
    ],
    "recommends": [
      { "id": "pf2e-toolbelt", "type": "module" },
      { "id": "pf2e-automations", "type": "module" }
    ]
  },
  "documentTypes": {
    "RegionBehavior": { "zone": {}, "height": {} }
  },
  "socket": true,
  "esmodules": ["scripts/main.mjs"],
  "styles": ["styles/chat.css", "styles/sheet.css", "styles/zone.css", "styles/workshop.css"],
