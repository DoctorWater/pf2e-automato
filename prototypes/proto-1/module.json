{
  "id": "pf2e-autoflow-proto-1",
  "title": "PF2e Autoflow (proto 1: chat pipeline)",
  "description": "Prototype: MIDI-like declarative rule pipeline on top of pf2e chat messages and regions.",
  "version": "0.0.1",
  "compatibility": { "minimum": "14", "verified": "14.366" },
  "authors": [{ "name": "pf2e-autoflow" }],
  "relationships": {
    "systems": [{ "id": "pf2e", "type": "system", "compatibility": { "minimum": "8.6.1" } }],
    "requires": [
      { "id": "lib-wrapper", "type": "module" },
      { "id": "socketlib", "type": "module" }
    ]
  },
  "socket": true,
  "esmodules": ["scripts/main.mjs"],
  "styles": ["styles/autoflow.css"],
  "languages": [
    { "lang": "ru", "name": "Русский", "path": "lang/ru.json" },
    { "lang": "en", "name": "English", "path": "lang/en.json" }
