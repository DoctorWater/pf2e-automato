{
  "id": "pf2e-autoflow-proto-2",
  "title": "PF2e Autoflow (proto 2: Rule Elements)",
  "description": "Prototype: automation as custom pf2e Rule Elements (AutoflowZone, AutoflowSave, AutoflowEffect, AutoflowReaction).",
  "version": "0.0.1",
  "compatibility": { "minimum": "14", "verified": "14.366" },
  "authors": [{ "name": "pf2e-autoflow" }],
  "esmodules": ["scripts/main.js"],
  "styles": ["styles/autoflow.css"],
  "languages": [
    { "lang": "en", "name": "English", "path": "lang/en.json" },
    { "lang": "ru", "name": "Русский", "path": "lang/ru.json" }
