<div class="ws-foot">
  <span class="ws-foot-msg {{#if errors.length}}ws-err{{/if}}">
    {{#if error}}{{error}}{{else}}{{#if dirty}}<span class="ws-dot" aria-hidden="true"></span>{{/if}}{{status}}{{#if lockedFlag}} · {{localize "PF2E_AUTOMATO.sheet.locked"}}{{/if}}{{/if}}
  </span>
  <button type="button" class="ws-btn ws-btn-g" data-action="resetDraft" name="resetDraft" {{#unless dirty}}disabled{{/unless}}>{{localize "PF2E_AUTOMATO.workshop.au.reset"}}</button>
  {{#if canUnset}}<button type="button" class="ws-btn ws-btn-g" data-action="unsetRule" name="unsetRule">{{localize "PF2E_AUTOMATO.workshop.au.unset"}}</button>{{/if}}
  <details class="ws-menu" data-sync="world">
    <summary class="ws-btn">{{localize "PF2E_AUTOMATO.workshop.au.world"}} <i class="fa-solid fa-chevron-up" inert></i></summary>
    <div class="ws-menu-list">
      <button type="button" data-action="worldSave" data-scope="source" name="worldSave-source" {{#if errors.length}}disabled{{else if noSource}}disabled{{/if}}>{{localize "PF2E_AUTOMATO.sheet.worldSource"}}</button>
      <button type="button" data-action="worldSave" data-scope="slug" name="worldSave-slug" {{#if errors.length}}disabled{{else if noSlug}}disabled{{/if}}>{{localize "PF2E_AUTOMATO.sheet.worldSlug"}}</button>
      {{#if isWorld}}
      <button type="button" data-action="worldDel" data-scope="source" name="worldDel-source" {{#if noSource}}disabled{{/if}}>{{localize "PF2E_AUTOMATO.sheet.delWorldSource"}}</button>
      <button type="button" data-action="worldDel" data-scope="slug" name="worldDel-slug" {{#if noSlug}}disabled{{/if}}>{{localize "PF2E_AUTOMATO.sheet.delWorldSlug"}}</button>
      {{/if}}
    </div>
  </details>
  <button type="button" class="ws-btn ws-btn-p" data-action="saveItem" name="saveItem" {{#if errors.length}}disabled{{else if lockedFlag}}disabled{{/if}}>{{localize "PF2E_AUTOMATO.sheet.saveFlag"}}</button>
</div>
