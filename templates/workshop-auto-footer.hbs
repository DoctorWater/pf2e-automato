<div class="ws-foot">
  <span class="ws-foot-msg {{#if errors.length}}ws-err{{/if}}">
    {{#if errors.length}}
      {{#if errMore}}
      <details class="ws-errs" {{#if errOpen}}open{{/if}}><summary>{{errors.[0]}} {{errMore}}</summary><ul>{{#each errors}}<li>{{this}}</li>{{/each}}</ul></details>
      {{else}}{{errors.[0]}}{{/if}}
    {{else}}{{#if dirty}}<span class="ws-dot" aria-hidden="true"></span>{{/if}}{{status}}{{#if lockedFlag}} · {{localize "PF2E_AUTOMATO.sheet.locked"}}{{/if}}{{/if}}
  </span>
  <button type="button" class="ws-btn ws-btn-g" data-action="resetDraft" name="resetDraft" {{#unless dirty}}disabled{{/unless}}>{{localize "PF2E_AUTOMATO.workshop.au.reset"}}</button>
  {{#unless passive}}
  {{#if canUnset}}<button type="button" class="ws-btn ws-btn-g" data-action="unsetRule" name="unsetRule" title="{{localize "PF2E_AUTOMATO.workshop.mech.unsetHint"}}">{{localize "PF2E_AUTOMATO.workshop.au.unset"}}</button>{{/if}}
  <details class="ws-menu" data-sync="world">
    <summary class="ws-btn">{{localize "PF2E_AUTOMATO.workshop.au.world"}} <i class="fa-solid fa-chevron-up" inert></i></summary>
    <div class="ws-menu-list">
      {{#if mechOnlyWorld}}<p class="ws-note ws-menu-note">{{localize "PF2E_AUTOMATO.workshop.mech.worldNote"}}</p>{{/if}}
      <button type="button" data-action="worldSave" data-scope="source" name="worldSave-source" {{#if ruleBad}}disabled{{else if noRuleSave}}disabled{{else if noSource}}disabled title="{{noSourceHint}}"{{/if}}>{{worldSourceLabel}}</button>
      <button type="button" data-action="worldSave" data-scope="slug" name="worldSave-slug" {{#if ruleBad}}disabled{{else if noRuleSave}}disabled{{else if noSlug}}disabled{{/if}}>{{localize "PF2E_AUTOMATO.sheet.worldSlug"}}</button>
      {{#if isWorld}}
      <button type="button" data-action="worldDel" data-scope="source" name="worldDel-source" {{#if noSource}}disabled{{/if}}>{{delWorldSourceLabel}}</button>
      <button type="button" data-action="worldDel" data-scope="slug" name="worldDel-slug" {{#if noSlug}}disabled{{/if}}>{{localize "PF2E_AUTOMATO.sheet.delWorldSlug"}}</button>
      {{/if}}
    </div>
  </details>
  {{/unless}}
  <button type="button" class="ws-btn ws-btn-p" data-action="saveItem" name="saveItem" {{#if saveOff}}disabled{{/if}}>{{localize "PF2E_AUTOMATO.sheet.saveFlag"}}</button>
</div>
