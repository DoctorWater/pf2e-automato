<div class="ws-col">
{{#*inline "fld"}}
{{#if refine}}
<div class="ws-fld ws-full ws-refine"><span class="ws-lbl">{{label}}</span>
  <div class="ws-pills" role="group" aria-label="{{label}}">
    {{#each refine.list}}
    {{#if locked}}<button type="button" class="ws-pill is-off" aria-disabled="true" data-tooltip="{{tip}}" name="pill-{{path}}-{{key}}">{{label}}</button>
    {{else}}<button type="button" class="ws-pill {{#if bad}}is-bad{{/if}}" data-action="rowOp" data-path="{{path}}" data-op="pill:{{key}}" aria-pressed="{{on}}" {{#if card}}aria-expanded="{{open}}"{{/if}} {{#if bad}}data-tooltip="{{tip}}"{{/if}} name="pill-{{path}}-{{key}}">{{label}}{{#if card}}<i class="fa-solid fa-chevron-down" inert></i>{{/if}}</button>{{/if}}
    {{/each}}
  </div>
  {{#with refine.card}}
  <div class="ws-pop" role="group" aria-label="{{title}}">
    <div class="ws-pop-h">{{title}}</div>
    <div class="ws-pop-b">
      {{#each fields}}{{> fld}}{{/each}}
      {{#if hint}}<div class="ws-note">{{hint}}</div>{{/if}}
      <button type="button" class="ws-btn ws-btn-g ws-pop-off" data-action="rowOp" data-path="{{path}}" data-op="pillOff:{{key}}" name="pillOff-{{path}}-{{key}}">{{off}}</button>
    </div>
  </div>
  {{/with}}
</div>
{{else if mods}}
<div class="ws-fld ws-full">
  {{#if mods.label}}<span class="ws-lbl">{{mods.label}}</span>{{/if}}
  {{#if mods.list.length}}
  <div class="ws-modlist">
    {{#each mods.list}}
    <div class="ws-mod"><span class="ws-kind">{{kind}}</span>
      <div class="ws-modf">{{#each fields}}{{> fld}}{{/each}}</div>
      <button type="button" class="ws-x" data-action="rowOp" data-path="{{rm.path}}" data-op="{{rm.op}}" name="rmMod-{{rm.path}}-{{i}}" aria-label="{{localize "PF2E_AUTOMATO.workshop.au.mod.remove"}}"><i class="fa-solid fa-xmark" inert></i></button>
    </div>
    {{/each}}
  </div>
  {{else}}<div class="ws-dnone">{{mods.empty}}</div>{{/if}}
  <div class="ws-adds">{{#each mods.adds}}<button type="button" class="ws-add" data-action="rowOp" data-path="{{path}}" data-op="{{op}}" name="modAdd-{{path}}-{{op}}" {{#if off}}disabled{{/if}}><i class="fa-solid fa-plus" inert></i> {{label}}</button>{{/each}}<span class="ws-note">{{mods.hint}}</span></div>
  {{#if mods.note}}<div class="ws-note">{{mods.note}}</div>{{/if}}
</div>
{{else if affl}}
<div class="ws-fld ws-full ws-affl">
  {{#if affl.bad}}<div class="ws-dnone">{{affl.bad}}</div>{{else}}
  {{#if affl.shared}}<div class="ws-adds"><span class="ws-note">{{affl.shared}}</span><button type="button" class="ws-add" data-action="rowOp" data-path="{{affl.split.path}}" data-op="{{affl.split.op}}" name="split-{{affl.split.path}}" title="{{affl.split.tip}}">{{affl.split.label}}</button></div>{{/if}}
  <div class="ws-arow">{{#each affl.head}}{{> fld}}{{/each}}</div>
  <div class="ws-fld"><span class="ws-lbl">{{affl.stagesLabel}}</span>
    <div class="ws-stg">
      {{#each affl.stages}}
      <div class="ws-st {{#if open}}is-open{{/if}}">
        <button type="button" class="ws-st-t" data-action="rowOp" data-path="{{openOp.path}}" data-op="{{openOp.op}}" aria-expanded="{{open}}" name="stage-{{path}}-{{i}}"><span class="ws-no">{{no}}</span><span class="ws-st-l" data-plate="{{linePath}}">{{line}}</span></button>
        <button type="button" class="ws-x" data-action="rowOp" data-path="{{rm.path}}" data-op="{{rm.op}}" name="stageRm-{{path}}-{{i}}" {{#if rm.off}}disabled{{/if}} aria-label="{{localize "PF2E_AUTOMATO.workshop.au.affl.removeStage" n=no}}"><i class="fa-solid fa-xmark" inert></i></button>
      </div>
      {{#if open}}<div class="ws-stb">{{#each body}}{{> fld}}{{/each}}</div>{{/if}}
      {{/each}}
    </div>
    <div class="ws-adds"><button type="button" class="ws-add" data-action="rowOp" data-path="{{affl.add.path}}" data-op="{{affl.add.op}}" name="stageAdd-{{affl.add.path}}" {{#if affl.add.off}}disabled{{/if}}><i class="fa-solid fa-plus" inert></i> {{affl.add.label}}</button></div>
  </div>
  {{/if}}
</div>
{{else if degs}}
<div class="ws-fld ws-full"><span class="ws-lbl">{{degs.label}}</span>
  <div class="ws-dgrid">{{#each degs.cols}}<div class="ws-dcol"><div class="ws-lbl ws-dhead ws-d-{{deg}}">{{label}}</div>{{> lst}}</div>{{/each}}</div>
</div>
{{else if pair}}
<div class="ws-fld"><span class="ws-lbl">{{pair.label}}</span><div class="ws-row">{{#each pair.fields}}{{> fld}}{{/each}}</div></div>
{{else if lines}}
<div class="ws-fld"><span class="ws-lbl">{{lines.label}}</span>
  {{#each lines.list}}<div class="ws-row">{{#each fields}}{{> fld}}{{/each}}<button type="button" class="ws-x" data-action="rowOp" data-path="{{rm.path}}" data-op="{{rm.op}}" name="rmLine-{{rm.path}}-{{rm.op}}" aria-label="{{localize "PF2E_AUTOMATO.workshop.au.affl.remove"}}"><i class="fa-solid fa-xmark" inert></i></button></div>{{/each}}
  <div class="ws-adds"><button type="button" class="ws-add" data-action="rowOp" data-path="{{lines.add.path}}" data-op="{{lines.add.op}}" name="addLine-{{lines.add.path}}-{{lines.add.op}}" {{#if lines.add.off}}disabled{{/if}}><i class="fa-solid fa-plus" inert></i> {{lines.add.label}}</button></div>
</div>
{{else if chips}}
<div class="ws-fld"><span class="ws-lbl">{{chips.label}}</span>
  <div class="ws-adds">
    {{#each chips.list}}
    <div class="ws-plate ws-chip"><span class="ws-plate-t ws-static"><span class="ws-plate-n">{{name}}</span></span>
      {{#if stepper}}<span class="ws-stp">
        <button type="button" data-action="rowOp" data-path="{{dec.path}}" data-op="{{dec.op}}" name="dec-{{dec.op}}-{{dec.path}}" aria-label="{{localize "PF2E_AUTOMATO.workshop.au.dec" name=name}}"><i class="fa-solid fa-minus" inert></i></button>
        <b>{{value}}</b>
        <button type="button" data-action="rowOp" data-path="{{inc.path}}" data-op="{{inc.op}}" name="inc-{{inc.op}}-{{inc.path}}" aria-label="{{localize "PF2E_AUTOMATO.workshop.au.inc" name=name}}"><i class="fa-solid fa-plus" inert></i></button>
      </span>{{/if}}
      <button type="button" class="ws-x" data-action="rowOp" data-path="{{rm.path}}" data-op="{{rm.op}}" name="rm-{{rm.op}}-{{rm.path}}" aria-label="{{localize "PF2E_AUTOMATO.workshop.au.affl.removeCond" name=name}}"><i class="fa-solid fa-xmark" inert></i></button>
    </div>
    {{/each}}
    {{#if chips.add}}{{#with chips.add}}{{> fld}}{{/with}}{{/if}}
  </div>
</div>
{{else if opts}}
<div class="ws-fld ws-full"><span class="ws-lbl">{{label}}</span>
  {{#each opts.list}}
  <div class="ws-opt">{{#each fields}}{{> fld}}{{/each}}
    <button type="button" class="ws-x" data-action="rowOp" data-path="{{rm.path}}" data-op="{{rm.op}}" name="rmOpt-{{rm.path}}-{{i}}" aria-label="{{localize "PF2E_AUTOMATO.workshop.au.chs.remove"}}"><i class="fa-solid fa-xmark" inert></i></button>
  </div>
  {{/each}}
  <div class="ws-adds"><button type="button" class="ws-add" data-action="rowOp" data-path="{{opts.add.path}}" data-op="{{opts.add.op}}" name="addOpt-{{opts.add.path}}"><i class="fa-solid fa-plus" inert></i> {{localize "PF2E_AUTOMATO.workshop.au.chs.add"}}</button><span class="ws-note">{{opts.hint}}</span></div>
</div>
{{else if group}}
<div class="ws-fld"><span class="ws-lbl">{{group.label}}</span><div class="ws-chks">{{#each group.fields}}{{> fld}}{{/each}}</div></div>
{{else if note}}
<span class="ws-note ws-inl">{{note}}</span>
{{else if seg}}
<div class="ws-fld"><span class="ws-lbl">{{label}}</span>
  <div class="ws-seg">{{#each seg}}<button type="button" data-action="pick" data-a="{{../path}}" data-v="{{value}}" aria-pressed="{{on}}" name="{{../path}}-{{value}}">{{label}}</button>{{/each}}</div>
</div>
{{else if check}}
<label class="ws-check" {{#if tip}}title="{{tip}}"{{/if}}><input type="checkbox" data-a="{{path}}" name="{{path}}" {{checked value}} {{#if disabled}}disabled{{/if}}><span>{{label}}</span></label>
{{else if options}}
<label class="ws-fld" {{#if tip}}title="{{tip}}"{{/if}}><span class="ws-lbl {{#if bare}}ws-sr{{/if}}">{{label}}</span><select class="ws-inp" data-a="{{path}}" name="{{path}}" {{#if drop}}data-drop="{{drop}}"{{/if}}>{{selectOptions options selected=value valueAttr="value" labelAttr="label"}}</select></label>
{{else}}
<label class="ws-fld {{cls}}" {{#if tip}}title="{{tip}}"{{/if}}><span class="ws-lbl {{#if bare}}ws-sr{{/if}}">{{label}}{{#if req}} <span class="ws-req" aria-hidden="true">*</span>{{/if}}</span>{{#if area}}<textarea class="ws-inp ws-area {{inpCls}}" spellcheck="false" data-a="{{path}}" name="{{path}}" placeholder="{{placeholder}}">{{value}}</textarea>{{else}}<input class="ws-inp {{inpCls}}" type="{{type}}" data-a="{{path}}" name="{{path}}" value="{{value}}" {{#if drop}}data-drop="{{drop}}"{{/if}} {{#if list}}list="{{list}}"{{/if}} {{#if min}}min="{{min}}"{{/if}} {{#if max}}max="{{max}}"{{/if}} {{#if step}}step="{{step}}"{{/if}} placeholder="{{placeholder}}" {{#if req}}aria-required="true"{{/if}}>{{/if}}{{#if hint}}<span class="ws-note">{{hint}}</span>{{/if}}</label>
{{/if}}
{{/inline}}
{{#*inline "plate"}}
<div class="ws-plate {{#if open}}is-open{{/if}} {{#if stepper}}has-stp{{/if}}">
  <button type="button" class="ws-plate-t" data-action="toggleStep" data-path="{{path}}" aria-expanded="{{open}}" name="plate-{{path}}">
    {{#if self}}<i class="fa-solid fa-user" inert data-tooltip="PF2E_AUTOMATO.sheet.to.self"></i>{{/if}}<span class="ws-plate-nw"><span class="ws-plate-n" data-plate="{{path}}">{{text}}</span>{{#if note}}<small class="ws-plate-sub">{{note}}</small>{{/if}}</span>
  </button>
  {{#if stepper}}<span class="ws-stp">
    <button type="button" data-action="stepVal" data-path="{{path}}" data-d="-1" name="dec-{{path}}" aria-label="{{localize "PF2E_AUTOMATO.workshop.au.dec" name=name}}"><i class="fa-solid fa-minus" inert></i></button>
    <b data-pv="{{path}}">{{value}}</b>
    <button type="button" data-action="stepVal" data-path="{{path}}" data-d="1" name="inc-{{path}}" aria-label="{{localize "PF2E_AUTOMATO.workshop.au.inc" name=name}}"><i class="fa-solid fa-plus" inert></i></button>
  </span>{{/if}}
  <button type="button" class="ws-x" data-action="removeStep" data-path="{{path}}" name="rm-{{path}}" aria-label="{{localize "PF2E_AUTOMATO.workshop.au.removeStep"}}"><i class="fa-solid fa-xmark" inert></i></button>
</div>
{{/inline}}
{{#*inline "lst"}}
<div class="ws-lst" data-list="{{list}}">
  {{#each steps}}{{> plate}}{{/each}}
  {{#each ghosts}}{{#if timed}}<span class="ws-ghost is-off" data-tooltip="{{tip}}">{{text}}</span>{{else}}<button type="button" class="ws-ghost" data-action="addStep" data-list="{{../list}}" data-slug="{{slug}}" name="ghost-{{slug}}-{{../list}}" data-tooltip="{{tip}}">{{text}}</button>{{/if}}{{/each}}
  {{#unless steps.length}}{{#unless quiet}}<div class="ws-dnone">{{localize "PF2E_AUTOMATO.workshop.au.noEffects"}}</div>{{/unless}}{{/unless}}
  <div class="ws-padd">
    <button type="button" class="ws-add" data-action="togglePicker" data-list="{{list}}" name="add-{{list}}" aria-expanded="{{picker}}"><i class="fa-solid fa-plus" inert></i> {{#if quiet}}{{localize "PF2E_AUTOMATO.workshop.au.addImmediate"}}{{else}}{{localize "PF2E_AUTOMATO.workshop.au.add"}}{{/if}}</button>
    {{#if picker}}
    <div class="ws-pick">
      <input type="search" data-filter name="filter-{{list}}" placeholder="{{localize "PF2E_AUTOMATO.workshop.au.search"}}" aria-label="{{localize "PF2E_AUTOMATO.workshop.au.search"}}">
      <div class="ws-pick-list">
        <div class="ws-pick-h" data-q="">{{localize "PF2E_AUTOMATO.workshop.au.pickKinds"}}</div>
        <button type="button" data-action="addStep" data-list="{{list}}" data-kind="effect" name="addk-effect-{{list}}" data-q="">{{localize "PF2E_AUTOMATO.workshop.au.kindEffect"}}</button>
        <button type="button" data-action="addStep" data-list="{{list}}" data-kind="visibility" name="addk-vis-{{list}}" data-q="">{{localize "PF2E_AUTOMATO.workshop.au.kindVisibility"}}</button>
        <button type="button" data-action="addStep" data-list="{{list}}" data-kind="persistent" name="addk-pers-{{list}}" data-q="">{{localize "PF2E_AUTOMATO.workshop.au.kindPersistent"}}</button>
        <button type="button" data-action="addStep" data-list="{{list}}" data-kind="remove" name="addk-remove-{{list}}" data-q="">{{localize "PF2E_AUTOMATO.workshop.au.kindRemove"}}</button>
        <button type="button" data-action="addStep" data-list="{{list}}" data-kind="removeEffect" name="addk-removeEffect-{{list}}" data-q="">{{localize "PF2E_AUTOMATO.workshop.au.kindRemoveEffect"}}</button>
        <button type="button" data-action="addStep" data-list="{{list}}" data-kind="extendEffect" name="addk-extendEffect-{{list}}" data-q="">{{localize "PF2E_AUTOMATO.workshop.au.kindExtendEffect"}}</button>
        <button type="button" data-action="addStep" data-list="{{list}}" data-kind="refundFocus" name="addk-refundFocus-{{list}}" data-q="">{{localize "PF2E_AUTOMATO.workshop.au.kindRefundFocus"}}</button>
        <button type="button" data-action="addStep" data-list="{{list}}" data-kind="rollOption" name="addk-rollOption-{{list}}" data-q="">{{localize "PF2E_AUTOMATO.workshop.au.kindRollOption"}}</button>
        <button type="button" data-action="addStep" data-list="{{list}}" data-kind="damage" name="addk-damage-{{list}}" data-q="">{{localize "PF2E_AUTOMATO.workshop.au.kindDamage"}}</button>
        <button type="button" data-action="addStep" data-list="{{list}}" data-kind="move" name="addk-move-{{list}}" data-q="">{{localize "PF2E_AUTOMATO.workshop.au.kindMove"}}</button>
        <button type="button" data-action="addStep" data-list="{{list}}" data-kind="choose" name="addk-choose-{{list}}" data-q="">{{localize "PF2E_AUTOMATO.workshop.au.kindChoose"}}</button>
        <button type="button" data-action="addStep" data-list="{{list}}" data-kind="affliction" name="addk-affliction-{{list}}" data-q="">{{localize "PF2E_AUTOMATO.workshop.au.kindAffliction"}}</button>
        {{#if coat}}<button type="button" data-action="addStep" data-list="{{list}}" data-kind="coat" name="addk-coat-{{list}}" data-q="">{{localize "PF2E_AUTOMATO.workshop.au.kindCoat"}}</button>{{/if}}
        <button type="button" data-action="addStep" data-list="{{list}}" data-kind="note" name="addk-note-{{list}}" data-q="">{{localize "PF2E_AUTOMATO.workshop.au.kindNote"}}</button>
        <div class="ws-pick-h" data-q="">{{localize "PF2E_AUTOMATO.workshop.au.pickConds"}}</div>
        {{#each @root.conds}}<button type="button" data-action="addStep" data-list="{{../list}}" data-slug="{{slug}}" name="addc-{{slug}}-{{../list}}" data-q="{{q}}">{{label}}</button>{{/each}}
      </div>
      <div class="ws-note">{{localize "PF2E_AUTOMATO.workshop.au.dragHint"}}</div>
    </div>
    {{/if}}
  </div>
</div>
{{/inline}}
<datalist id="ws-skills">{{#each skills}}<option value="{{this}}"></option>{{/each}}</datalist>
{{#if doubleWarn}}<p class="ws-warn">{{doubleWarn}}</p>{{/if}}
<h2 class="ws-h">{{localize "PF2E_AUTOMATO.workshop.au.pipeline"}}</h2>
<div class="ws-pipe">
  {{#each rows as |r|}}
  <div class="ws-prow">
    <div class="ws-prail"><span class="ws-pchip {{#if r.hot}}is-hot{{/if}}">{{r.label}}</span></div>
    <div class="ws-pbody">
      {{#if r.fold}}
      <button type="button" class="ws-psum" data-action="toggleRow" data-row="{{r.key}}" aria-expanded="{{r.open}}" name="row-{{r.key}}"><span class="ws-sum" data-sum="{{r.key}}">{{r.sum}}</span><i class="fa-solid fa-chevron-down ws-chev" inert></i></button>
      {{else}}
      <div class="ws-psum ws-psum-static"><span class="ws-sum" data-sum="{{r.key}}">{{r.sum}}</span></div>
      {{/if}}
      {{#if r.open}}
      <div class="ws-pfields">
        {{#each r.fields}}{{> fld}}{{/each}}
        {{#if r.area}}
        <div class="ws-areanote ws-full"><i class="fa-solid fa-circle-info" inert></i><span>{{r.area.note}}</span>
          {{#if r.area.insert}}<button type="button" class="ws-btn" data-action="insertTemplate" name="insertTemplate" {{#if r.area.locked}}disabled{{/if}}>{{localize "PF2E_AUTOMATO.workshop.au.insertTemplate"}}</button>{{/if}}
        </div>
        {{/if}}
        {{#if r.is_outcome}}
        {{#if r.cols}}<div class="ws-dgrid ws-full">{{#each r.cols}}<div class="ws-dcol"><div class="ws-lbl ws-dhead ws-d-{{deg}}">{{label}}</div>{{> lst}}</div>{{/each}}</div>{{/if}}
        {{#if r.hintExcluded}}<div class="ws-note ws-full ws-hintx">{{r.hintExcluded}}</div>{{/if}}
        <div class="ws-dimm ws-full">{{#unless r.imm.quiet}}<div class="ws-lbl ws-dhead">{{r.imm.label}}</div>{{/unless}}{{> lst r.imm}}</div>
        {{#if r.edit}}
        <div class="ws-sted ws-full">
          <div class="ws-lbl ws-accent">{{r.edit.title}}</div>
          {{#if r.edit.back}}<button type="button" class="ws-btn ws-btn-g" data-action="toggleStep" data-path="{{r.edit.back.path}}" name="coatBack"><i class="fa-solid fa-chevron-left" inert></i> {{r.edit.back.label}}</button>{{/if}}
          <div class="ws-sted-f">{{#each r.edit.fields}}{{> fld}}{{/each}}</div>
        </div>
        {{/if}}
        {{/if}}
        {{#if r.is_events}}
        <div class="ws-evs ws-full">
          <span class="ws-note">{{localize "PF2E_AUTOMATO.workshop.au.ev.hint"}}</span>
          {{#each r.evs}}
          <div class="ws-ev">
            <div class="ws-ev-h"><span class="ws-lbl ws-accent">{{title}}</span>
              <button type="button" class="ws-x" data-action="removeEvent" data-i="{{i}}" name="rmEvent-{{i}}" aria-label="{{localize "PF2E_AUTOMATO.workshop.au.ev.remove"}}"><i class="fa-solid fa-xmark" inert></i></button>
            </div>
            <div class="ws-pfields">{{#each fields}}{{> fld}}{{/each}}</div>
            <div class="ws-lbl ws-dhead">{{apply.label}}</div>
            {{> lst apply}}
            {{#if cols}}<div class="ws-dgrid ws-full">{{#each cols}}<div class="ws-dcol"><div class="ws-lbl ws-dhead ws-d-{{deg}}">{{label}}</div>{{> lst}}</div>{{/each}}</div>{{/if}}
          </div>
          {{/each}}
          <button type="button" class="ws-add" data-action="addEvent" name="addEvent"><i class="fa-solid fa-plus" inert></i> {{localize "PF2E_AUTOMATO.workshop.au.ev.add"}}</button>
          {{#if r.edit}}
          <div class="ws-sted ws-full">
            <div class="ws-lbl ws-accent">{{r.edit.title}}</div>
            <div class="ws-sted-f">{{#each r.edit.fields}}{{> fld}}{{/each}}</div>
          </div>
          {{/if}}
        </div>
        {{/if}}
        {{#if r.is_cast}}
        <div class="ws-evs ws-full">
          <span class="ws-note">{{localize "PF2E_AUTOMATO.workshop.au.cast.hint"}}</span>
          {{#each r.casts}}
          <div class="ws-ev">
            <div class="ws-ev-h"><span class="ws-lbl ws-accent">{{title}}</span>
              <button type="button" class="ws-x" data-action="removeCast" data-i="{{i}}" name="rmCast-{{i}}" aria-label="{{localize "PF2E_AUTOMATO.workshop.au.cast.remove"}}"><i class="fa-solid fa-xmark" inert></i></button>
            </div>
            <div class="ws-pfields">{{#each fields}}{{> fld}}{{/each}}</div>
            {{#if choices}}
            {{#each choices}}
            <div class="ws-ev ws-choice">
              <div class="ws-ev-h"><span class="ws-lbl">{{title}}</span>
                <button type="button" class="ws-x" data-action="removeChoice" data-i="{{../i}}" data-j="{{j}}" name="rmChoice-{{../i}}-{{j}}" {{#if off}}disabled{{/if}} aria-label="{{localize "PF2E_AUTOMATO.workshop.au.cast.removeChoice"}}"><i class="fa-solid fa-xmark" inert></i></button>
              </div>
              <div class="ws-pfields">{{#each fields}}{{> fld}}{{/each}}</div>
            </div>
            {{/each}}
            <button type="button" class="ws-add" data-action="addChoice" data-i="{{i}}" name="addChoice-{{i}}" {{#if addOff}}disabled{{/if}}><i class="fa-solid fa-plus" inert></i> {{localize "PF2E_AUTOMATO.workshop.au.cast.addChoice"}}</button>
            {{/if}}
          </div>
          {{/each}}
          <button type="button" class="ws-add" data-action="addCast" name="addCast"><i class="fa-solid fa-plus" inert></i> {{localize "PF2E_AUTOMATO.workshop.au.cast.add"}}</button>
        </div>
        {{/if}}
        {{#if r.is_trig}}
        <div class="ws-evs ws-full">
          <span class="ws-note">{{localize "PF2E_AUTOMATO.workshop.au.trg.hint"}}</span>
          {{#each r.trgs}}
          <div class="ws-ev">
            <div class="ws-ev-h"><span class="ws-lbl ws-accent">{{title}}</span>
              <button type="button" class="ws-x" data-action="removeTrigger" data-i="{{i}}" name="rmTrigger-{{i}}" aria-label="{{localize "PF2E_AUTOMATO.workshop.au.trg.remove"}}"><i class="fa-solid fa-xmark" inert></i></button>
            </div>
            <div class="ws-pfields">{{#each fields}}{{> fld}}{{/each}}</div>
            <div class="ws-lbl ws-dhead">{{apply.label}}</div>
            {{> lst apply}}
            {{#if cols}}<div class="ws-dgrid ws-full">{{#each cols}}<div class="ws-dcol"><div class="ws-lbl ws-dhead ws-d-{{deg}}">{{label}}</div>{{> lst}}</div>{{/each}}</div>{{/if}}
          </div>
          {{/each}}
          <button type="button" class="ws-add" data-action="addTrigger" name="addTrigger"><i class="fa-solid fa-plus" inert></i> {{localize "PF2E_AUTOMATO.workshop.au.trg.add"}}</button>
          {{#if r.edit}}
          <div class="ws-sted ws-full">
            <div class="ws-lbl ws-accent">{{r.edit.title}}</div>
            <div class="ws-sted-f">{{#each r.edit.fields}}{{> fld}}{{/each}}</div>
          </div>
          {{/if}}
        </div>
        {{/if}}
        {{#if r.is_macros}}
        <div class="ws-mlist ws-full">
          {{#each r.macros}}
          <div class="ws-mrow">
            {{#each fields}}{{> fld}}{{/each}}
            {{#if name}}<span class="ws-note">{{name}}</span>{{/if}}
            <button type="button" class="ws-x" data-action="removeStep" data-path="{{path}}" name="rm-{{path}}" aria-label="{{localize "PF2E_AUTOMATO.workshop.au.removeMacro"}}"><i class="fa-solid fa-xmark" inert></i></button>
          </div>
          {{/each}}
          <button type="button" class="ws-add" data-action="addMacro" name="addMacro"><i class="fa-solid fa-plus" inert></i> {{localize "PF2E_AUTOMATO.workshop.au.addMacro"}}</button>
          <span class="ws-note">{{localize "PF2E_AUTOMATO.workshop.au.macrosHint"}}</span>
        </div>
        {{/if}}
      </div>
      {{/if}}
    </div>
  </div>
  {{/each}}
</div>
</div>
