<div class="ws-col">
<section class="ws-dur">
  <div class="ws-fld">
    <span class="ws-lbl">{{localize "PF2E_AUTOMATO.workshop.duration"}}</span>
    <div class="ws-row">
      {{#unless unlimited}}<input class="ws-inp ws-num" type="number" min="1" data-f="dur.value" value="{{dur.value}}" aria-label="{{localize "PF2E_AUTOMATO.workshop.duration"}}" name="dur.value">{{/unless}}
      <div class="ws-seg">
        {{#each units}}<button type="button" data-action="pick" data-f="dur.unit" data-v="{{value}}" aria-pressed="{{on}}" name="dur.unit-{{value}}">{{label}}</button>{{/each}}
      </div>
    </div>
  </div>
  {{#unless unlimited}}
  <label class="ws-fld"><span class="ws-lbl">{{localize "PF2E_AUTOMATO.workshop.expires"}}</span>
    <select class="ws-inp" data-f="dur.expiry" name="dur.expiry">{{selectOptions expiry selected=dur.expiry}}</select>
  </label>
  {{/unless}}
  <label class="ws-check"><input type="checkbox" data-f="dur.counter" {{checked dur.counter}} name="dur.counter"><span>{{localize "PF2E_AUTOMATO.workshop.counter"}}</span></label>
</section>

{{> "modules/pf2e-automato/templates/workshop-blocks.hbs"}}
</div>
