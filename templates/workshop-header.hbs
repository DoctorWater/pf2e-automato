<div class="ws-head">
  <button type="button" class="ws-icon" data-action="pickImg" data-tooltip="PF2E_AUTOMATO.workshop.pickImg" aria-label="{{localize "PF2E_AUTOMATO.workshop.pickImg"}}"><img src="{{img}}" alt=""></button>
  <div class="ws-head-main">
    <div class="ws-head-row">
      <label class="ws-grow">
        <span class="ws-sr">{{localize "PF2E_AUTOMATO.workshop.name"}}</span>
        <input class="ws-title" type="text" data-f="name" value="{{name}}" placeholder="{{localize "PF2E_AUTOMATO.workshop.name"}}" name="name">
      </label>
      <label class="ws-inline">
        <span class="ws-lbl ws-accent">{{localize "PF2E_AUTOMATO.workshop.level"}}</span>
        <input class="ws-inp ws-num" type="number" min="0" data-f="level" value="{{level}}" name="level">
      </label>
    </div>
    <span class="ws-sub">{{subtitle}}</span>
  </div>
</div>
